# Non-secret Preview configuration. Do not commit real secrets.
SMTP_HOST=mail.eximpworld.hu
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@eximpworld.hu
SMTP_FROM=info@eximpworld.hu
# Set these securely in Vercel Preview, not in this file:
# SMTP_PASSWORD
# CONTACT_TOKEN_SECRET (cryptographically random, minimum 32 characters)
# CONTACT_REDIS_URL (approved TLS Redis endpoint)
CONTACT_EMAIL_ENABLED=false
CONTACT_DELIVERY_VERIFIED=false
